---
import Typography from '~components/ui/Typography.astro';
import Button from '~components/ui/Button.astro';
import { KICKSTART_CALL_URL } from '~consts/kickstart';
---

<div class="wrapper">
  <div class="content">
    <div class="card">
      <div class="stripe">
        <div class="bar agents" />
        <div class="bar workflows" />
        <div class="bar vector" />
        <div class="bar monitoring" />
      </div>
      <div class="cardInner">
        <Typography tag="span" styling="paragraphM" font="pixel" color="soft">
          NEURON AI / KICKSTART
        </Typography>
        <Typography tag="h2" styling="headingL">
          Have a project to build with Neuron?<br />Let's start your team.
        </Typography>
        <Typography tag="p" styling="paragraphL" color="subtle">
          Book a short intro call. If it's a fit, your team's first Neuron session is on us.
        </Typography>
        <div class="ctas">
          <Button href={KICKSTART_CALL_URL} text="Book your intro call" />
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0;
    }
  }

  .card {
    border: 1px solid var(--border-soft);
    background: var(--bg-weak);
  }

  .stripe {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 8px;
  }

  .agents {
    background: var(--bg-agents-base);
  }

  .workflows {
    background: var(--bg-workflows-base);
  }

  .vector {
    background: var(--bg-vector-base);
  }

  .monitoring {
    background: var(--bg-monitoring-base);
  }

  .cardInner {
    padding: var(--s-46) var(--s-24);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-24);

    @include media-min('md') {
      padding: var(--s-64) var(--s-46);
    }
  }

  .ctas {
    display: flex;
    gap: var(--s-12);
    flex-wrap: wrap;
    margin-top: var(--s-12);
  }
</style>
