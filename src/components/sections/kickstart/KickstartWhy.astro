---
import Typography from '~components/ui/Typography.astro';
---

<div class="wrapper">
  <div class="content">
    <Typography tag="span" styling="paragraphM" font="pixel" color="monitoring" align="center">
      WHY WE DO THIS
    </Typography>
    <Typography tag="h2" styling="headingL" align="center">
      Why we train your team for free
    </Typography>
    <Typography tag="p" styling="headingXs" color="subtle" align="center" class="body">
      How many frameworks do that? We're not selling seats. We're betting on your adoption: when your team ships on Neuron, we both win. So we put ourselves on the front line and get you building.
    </Typography>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-top: 1px solid var(--border-soft);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0;
    }
  }

  .content :global(.body) {
    margin-top: var(--s-12);
    max-width: 760px;
  }
</style>
