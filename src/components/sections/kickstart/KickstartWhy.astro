---
import Typography from '~components/ui/Typography.astro';
---

<div class="wrapper">
  <div class="content">
    <div class="card">
      <Typography tag="span" styling="paragraphM" font="pixel" color="monitoring" align="center">
        WHY WE DO THIS
      </Typography>
      <Typography tag="h2" styling="headingL" align="center">
        Why we train your team for free
      </Typography>
      <Typography tag="p" styling="headingXs" color="subtle" align="center" class="body">
        How many frameworks do that? We're not selling seats. We're betting on your adoption: when your team ships on Neuron, we both win. So we put ourselves on the front line and get you building.
      </Typography>
    </div>
    <div class="stripes">
      <div class="stripe agents" />
      <div class="stripe workflows" />
      <div class="stripe vector" />
      <div class="stripe monitoring" />
    </div>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    align-items: center;
    padding: var(--s-46) var(--s-24);
    border: 1px solid var(--border-soft);
    background-color: var(--bg-weak);

    @include media-min('md') {
      padding: var(--s-64) var(--s-46);
    }
  }

  .card :global(.body) {
    margin-top: var(--s-12);
    max-width: 760px;
  }

  .stripes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: var(--s-56);
  }

  .agents {
    background-color: var(--bg-agents-base);
  }

  .workflows {
    background-color: var(--bg-workflows-base);
  }

  .vector {
    background-color: var(--bg-vector-base);
  }

  .monitoring {
    background-color: var(--bg-monitoring-base);
  }
</style>
