---
import Typography from '~components/ui/Typography.astro';
import YouTubeEmbed from '~components/ui/YouTubeEmbed.astro';
---

<div class="wrapper">
  <div class="content">
    <Typography tag="h2" styling="headingL">
      What valantic says after the session
    </Typography>
    <figure class="testimonial">
      <YouTubeEmbed
        videoId="QF3eR6Ju7VM"
        title="Andreas Moser, valantic, on the Neuron Kickstart session"
      />
      <figcaption class="caption">
        <Typography tag="p" styling="paragraphL" color="subtle">
          Andreas Moser, Senior Backend Developer, valantic - Austria
        </Typography>
      </figcaption>
    </figure>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-top: 1px solid var(--border-soft);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-46);
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--s-64);
      padding: var(--s-100) 0;
    }
  }

  .testimonial {
    margin: 0;
  }

  .caption {
    margin-top: var(--s-24);
  }
</style>
