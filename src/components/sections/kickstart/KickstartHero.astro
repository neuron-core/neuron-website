---
import { Image } from 'astro:assets';
import Typography from '~components/ui/Typography.astro';
import Button from '~components/ui/Button.astro';
import heroGrid from '~assets/hero-grid.svg';
import { KICKSTART_CALL_URL } from '~consts/kickstart';

const FACTS = ['ABOUT 90 MINUTES', 'LIVE', 'WITH THE PEOPLE WHO BUILT NEURON'];
---

<div class="wrapper">
  <Image src={heroGrid} alt="" class="heroGrid" />

  <div class="content">
    <div class="inner">
      <Typography tag="span" styling="paragraphM" font="pixel" color="agents">
        NEURON AI / KICKSTART
      </Typography>
      <Typography tag="h1" styling="headingXl" class="title">
        Start your team on Neuron, with the people who built it.
      </Typography>
      <Typography tag="p" styling="paragraphL" color="subtle" class="lede">
        Bring a real project you want to build with Neuron. We get on a short call, and if it's a fit, we train your developers ourselves. On us. Your next application will be agentic, and we help your team get there fast.
      </Typography>
      <div class="ctas">
        <Button href={KICKSTART_CALL_URL} text="Book your intro call" />
        <Button href="#inside-the-session" text="See what we cover" variant="outline" />
      </div>
      <ul class="facts">
        {FACTS.map((fact) => (
          <li class="fact">
            <Typography tag="span" styling="bodyM" font="pixel" color="subtle">
              {fact}
            </Typography>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="stripe">
    <div class="bar agents" />
    <div class="bar workflows" />
    <div class="bar vector" />
    <div class="bar monitoring" />
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-bottom: 1px solid var(--border-soft);
  }

  .wrapper :global(.heroGrid) {
    pointer-events: none;
    position: absolute;
    top: 0;
    right: 0;
    display: none;
    width: auto;
    height: 100%;

    @include media-min('xl') {
      display: block;
    }
  }

  .content {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0 var(--s-64);
    }
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
  }

  .inner :global(.title) {
    max-width: 820px;
  }

  .inner :global(.lede) {
    max-width: 640px;
  }

  .ctas {
    display: flex;
    gap: var(--s-12);
    flex-wrap: wrap;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin: var(--s-12) 0 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: inline-flex;
    padding: var(--s-6) var(--s-12);
    border: 1px solid var(--border-soft);
    background-color: var(--bg-soft);
  }

  .stripe {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 8px;
  }

  .agents {
    background: var(--bg-agents-base);
  }

  .workflows {
    background: var(--bg-workflows-base);
  }

  .vector {
    background: var(--bg-vector-base);
  }

  .monitoring {
    background: var(--bg-monitoring-base);
  }
</style>
