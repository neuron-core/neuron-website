---
import Typography from '~components/ui/Typography.astro';

const STEPS = [
  {
    title: 'A short intro call',
    body: "Tell us about your team and the project you want to build with Neuron. We make sure it's a fit, both ways.",
  },
  {
    title: 'We onboard your team',
    body: "If it's a fit, we run a live session for your developers: our standard onboarding program, refined session after session, that gets your whole team ready to build with Neuron.",
  },
];
---

<div class="wrapper">
  <div class="content">
    <div class="header">
      <Typography tag="span" styling="paragraphM" font="pixel" color="vector">
        TWO STEPS
      </Typography>
      <Typography tag="h2" styling="headingL">
        How it works
      </Typography>
    </div>
    <ol class="steps">
      {STEPS.map((step, i) => (
        <li class="step">
          <div class="topLine" />
          <span class="number">
            {String(i + 1).padStart(2, '0')} /
          </span>
          <div class="stepContent">
            <Typography tag="h3" styling="headingM">
              {step.title}
            </Typography>
            <Typography tag="p" styling="paragraphL" color="subtle">
              {step.body}
            </Typography>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-top: 1px solid var(--border-soft);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-46);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0;
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--border-soft);

    @include media-min('sm') {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    padding: var(--s-32) var(--s-24);
    border-bottom: 1px solid var(--border-soft);
    background-color: var(--bg-weak);

    &:last-child {
      border-bottom: none;
    }

    @include media-min('sm') {
      padding: var(--s-46) var(--s-32);
      border-bottom: none;
      border-right: 1px solid var(--border-soft);

      &:last-child {
        border-right: none;
      }
    }

    @include media-min('lg') {
      padding: var(--s-56) var(--s-46);
    }
  }

  .topLine {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background-color: var(--bg-vector-base);
  }

  .number {
    font-family: GeistPixel, sans-serif;
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1.3;
    color: var(--bg-vector-base);
  }

  .stepContent {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }
</style>
