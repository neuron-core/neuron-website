---
import type { ImageMetadata } from 'astro';

interface Logo {
  image: ImageMetadata;
  alt: string;
  href?: string;
  // Optical override for logos whose mark is much taller than their wordmark
  height?: string;
}

interface Props {
  logos: Logo[];
}

const { logos } = Astro.props as Props;
---

<ul class="logoRow">
  {
    logos.map((logo) => {
      const Tag = logo.href ? 'a' : 'div';
      const linkProps = logo.href
        ? { href: logo.href, target: '_blank', rel: 'noopener noreferrer' }
        : {};

      return (
        <li>
          <Tag class="cell" {...linkProps}>
            <img
              src={logo.image.src}
              alt={logo.alt}
              width={logo.image.width}
              height={logo.image.height}
              style={logo.height ? { height: logo.height } : undefined}
              loading="lazy"
            />
          </Tag>
        </li>
      );
    })
  }
</ul>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .logoRow {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border-soft);
    list-style: none;

    @include media-min('sm') {
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
    }
  }

  li + li {
    border-top: 1px solid var(--border-soft);

    @include media-min('sm') {
      border-top: none;
      border-left: 1px solid var(--border-soft);
    }
  }

  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--s-40) var(--s-24);
    transition: background-color 0.25s ease;
  }

  a.cell:hover {
    background-color: var(--bg-weak);
  }

  img {
    width: auto;
    max-width: 100%;
    height: var(--s-32);
    object-fit: contain;
  }
</style>
