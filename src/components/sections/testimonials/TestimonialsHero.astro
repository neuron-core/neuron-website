---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import Typography from '~components/ui/Typography.astro';
import heroGrid from '~assets/hero-grid.svg';

const iconsDir = path.resolve('src/assets/icons');

const socials = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/106896704/',
    icon: fs.readFileSync(path.join(iconsDir, 'linkedin.svg'), 'utf-8'),
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/neuronai_php_adk/',
    icon: fs.readFileSync(path.join(iconsDir, 'instagram.svg'), 'utf-8'),
  },
  {
    name: 'X',
    href: 'https://x.com/neuronai_php',
    icon: fs.readFileSync(path.join(iconsDir, 'x.svg'), 'utf-8'),
  },
];
---

<div class="wrapper">
  <Image src={heroGrid} alt="" class="heroGrid" />

  <div class="content">
    <div class="inner">
      <Typography tag="span" styling="paragraphM" font="pixel" color="agents">
        NEURON AI / TESTIMONIALS
      </Typography>
      <Typography tag="h1" styling="headingXl">
        Built with Neuron
      </Typography>
      <Typography tag="p" styling="paragraphL" color="subtle" class="lede">
        Teams and products already running on Neuron. Hear what developers say
        after a Kickstart session, and see the products and the Drupal
        integration built on the framework.
      </Typography>

      <div class="socials">
        <Typography tag="span" styling="paragraphM" color="subtle">
          Follow us on:
        </Typography>

        <div class="socialLinks">
          {
            socials.map((social) => (
              <a
                class="socialLink"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class="stripe">
    <div class="bar agents" />
    <div class="bar workflows" />
    <div class="bar vector" />
    <div class="bar monitoring" />
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-bottom: 1px solid var(--border-soft);
  }

  .wrapper :global(.heroGrid) {
    pointer-events: none;
    position: absolute;
    top: 0;
    right: 0;
    display: none;
    width: auto;
    height: 100%;

    @include media-min('lg') {
      display: block;
    }
  }

  .content {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0 var(--s-64);
    }
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    padding: var(--s-32) 0;

    @include media-min('lg') {
      padding: var(--s-64) 0;
    }
  }

  .inner :global(.lede) {
    max-width: 640px;
  }

  .socials {
    display: flex;
    gap: var(--s-16);
    align-items: center;
  }

  .socialLinks {
    display: flex;
    gap: var(--s-12);
  }

  .socialLink {
    display: flex;
    color: var(--text-subtle);

    &:hover {
      color: var(--text-primary);
    }

    :global(svg) {
      width: var(--s-20);
      height: var(--s-20);
    }
  }

  .stripe {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 8px;
  }

  .agents {
    background: var(--bg-agents-base);
  }

  .workflows {
    background: var(--bg-workflows-base);
  }

  .vector {
    background: var(--bg-vector-base);
  }

  .monitoring {
    background: var(--bg-monitoring-base);
  }
</style>
