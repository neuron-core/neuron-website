---
import Typography from '~components/ui/Typography.astro';
---

<div class="wrapper">
  <div class="content">
    <div class="inner">
      <Typography tag="span" styling="paragraphM" font="pixel" color="agents">
        NEURON AI / PARTNER NETWORK
      </Typography>
      <Typography tag="h1" styling="headingXl">
        Neuron AI Partner<br />Network
      </Typography>
      <Typography tag="p" styling="paragraphL" color="subtle" class="lede">
        Join a small, vetted network of teams building production-ready agentic AI on Neuron, with a direct line to the people who build the framework you rely on.
      </Typography>
      <Typography tag="p" styling="paragraphM" class="intro">
        Neuron is the first agentic framework of the PHP ecosystem. Partners are the teams making it the core of how they ship AI in production.
      </Typography>
    </div>
  </div>
  <div class="stripe">
    <div class="bar agents" />
    <div class="bar workflows" />
    <div class="bar vector" />
    <div class="bar monitoring" />
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-bottom: 1px solid var(--border-soft);
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0 var(--s-64);
    }
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
  }

  .lede {
    max-width: 640px;
    padding-top: var(--s-12);
  }

  .intro {
    max-width: 640px;
  }

  .stripe {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 8px;
  }

  .agents {
    background: var(--bg-agents-base);
  }

  .workflows {
    background: var(--bg-workflows-base);
  }

  .vector {
    background: var(--bg-vector-base);
  }

  .monitoring {
    background: var(--bg-monitoring-base);
  }
</style>
