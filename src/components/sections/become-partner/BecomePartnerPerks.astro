---
import Typography from '~components/ui/Typography.astro';

const PERKS = [
  {
    title: 'A direct line to the core team',
    body: 'A priority channel to the maintainers plus a standing monthly session (around an hour, yours to split as you like), with a private Slack channel and roadmap previews before they ship. Unblock your hardest architectural decisions fast, and stay close to where Neuron is heading.',
  },
  {
    title: 'Priority attention on your issues and PRs',
    body: 'The things blocking your project get looked at first by the team, so you keep shipping instead of waiting.',
  },
  {
    title: 'Early access to what we ship next',
    body: "You are the first to try the products we build around Neuron, the ones that raise the ceiling on what you can build with agents and workflows. You build on what's coming before it goes public.",
  },
  {
    title: 'Ecosystem perks that pay for themselves',
    body: 'Benefits reserved to the network, shared between partners. Inspector alone gives partners 15% off its subscriptions, which on its own already covers a large part of the fee.',
  },
  {
    title: 'Co-marketing and visibility',
    body: 'Featured placement on neuron-ai.dev, joint case studies, and inbound leads matched on region and specialty, plus a spot in Neuron Hub to showcase your connectors and extensions.',
  },
];---

<div class="wrapper">
  <div class="content">
    <div class="leftCol">
      <Typography tag="span" styling="paragraphM" font="pixel" color="monitoring">
        WHAT YOU GET
      </Typography>
      <Typography tag="h2" styling="headingL">
        What you actually get as a Neuron Partner
      </Typography>
      <Typography tag="p" styling="paragraphL" color="subtle" class="subtitle">
        Recurring, hands-on access to the people building the framework you rely on, plus the visibility and perks that come with it.
      </Typography>
    </div>
    <ol class="list">
      {PERKS.map((perk, i) => (
        <li class:list={[{ first: i === 0 }]}>
          <span class="number">
            {String(i + 1).padStart(2, '0')} /
          </span>
          <div class="itemContent">
            <Typography tag="h3" styling="headingS" class="itemTitle">
              {perk.title}
            </Typography>
            <Typography tag="p" styling="paragraphL" color="subtle" class="itemBody">
              {perk.body}
            </Typography>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-top: 1px solid var(--border-soft);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-46);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--s-64);
      padding: var(--s-100) 0;
    }
  }

  .leftCol {
    display: flex;
    flex-direction: column;
    gap: var(--s-20);

    @include media-min('lg') {
      position: sticky;
      top: var(--s-100);
      align-self: start;
    }
  }

  .subtitle {
    margin: 0;
    margin-top: var(--s-12);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  li {
    display: flex;
    gap: var(--s-32);
    padding: var(--s-46) 0;
    border-bottom: 1px solid var(--border-soft);
    align-items: baseline;

    &.first {
      border-top: 1px solid var(--border-soft);
    }
  }

  .number {
    font-weight: 700;
    font-size: 2.4rem;
    color: var(--bg-monitoring-base);
    font-family: GeistPixel, sans-serif;
    line-height: 1.3;
    min-width: 5.6rem;
    margin: 0;
    flex-shrink: 0;
  }

  .itemContent {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
    flex: 1;
  }

  .itemTitle {
    font-weight: 500;
    margin: 0;
  }

  .itemBody {
    margin: 0;
    max-width: 640px;
  }
</style>
