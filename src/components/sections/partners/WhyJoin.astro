---
import Typography from '~components/ui/Typography.astro';
import Button from '~components/ui/Button.astro';

const WHY_JOIN_ITEMS = [
  {
    title: 'A direct line to the core team',
    body: 'A standing monthly session with the maintainers who build Neuron (around an hour, yours to split as you like), plus a private Slack channel and roadmap previews before they ship. When your product runs on Neuron, you are never far from the people who build it.',
  },
  {
    title: 'Priority attention on your issues and PRs',
    body: 'The things blocking your project get looked at first by the team, so you keep moving instead of waiting.',
  },
  {
    title: 'Early access to what we ship next',
    body: 'You see and help shape what we build around Neuron before it goes public, so your roadmap moves with the framework, not behind it.',
  },
  {
    title: 'Co-marketing and visibility',
    body: 'Featured placement on neuron-ai.dev, joint case studies, and inbound leads matched on region and specialty, plus preferential conditions across the ecosystem (Inspector gives partners 15% off its subscriptions).',
  },
];
---

<div class="wrapper">
  <div class="content">
    <div class="leftCol">
      <Typography tag="span" styling="paragraphM" font="pixel" color="monitoring">
        WHY JOIN
      </Typography>
      <Typography tag="h2" styling="headingL">
        Built for teams betting on Neuron.
      </Typography>
      <Typography tag="p" styling="paragraphL" color="subtle" class="subtitle">
        The partner program is selective on purpose. Four guarantees, in writing, for every partner.
      </Typography>
      <div class="cta">
        <Button href="/become-a-partner" text="become a partner" />
      </div>
    </div>
    <ol class="list">
      {WHY_JOIN_ITEMS.map((item, i) => (
        <li class:list={[{ first: i === 0 }]}>
          <span class="number">
            {String(i + 1).padStart(2, '0')} /
          </span>
          <div class="itemContent">
            <Typography tag="h3" styling="headingS" class="itemTitle">
              {item.title}
            </Typography>
            <Typography tag="p" styling="paragraphL" color="subtle" class="itemBody">
              {item.body}
            </Typography>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
    border-top: 1px solid var(--border-soft);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-46);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--s-64);
      padding: var(--s-100) 0;
    }
  }

  .leftCol {
    display: flex;
    flex-direction: column;
    gap: var(--s-20);
  }

  .eyebrow {
    margin: 0;
    color: var(--bg-monitoring-base);
    font-family: GeistPixel, sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
  }

  .subtitle {
    margin: 0;
    margin-top: var(--s-12);
  }

  .cta {
    margin-top: var(--s-12);
    align-self: flex-start;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  li {
    display: flex;
    gap: var(--s-32);
    padding: var(--s-46) 0;
    border-bottom: 1px solid var(--border-soft);
    align-items: baseline;

    &.first {
      border-top: 1px solid var(--border-soft);
    }
  }

  .number {
    font-weight: 700;
    font-size: 2.4rem;
    color: var(--bg-monitoring-base);
    font-family: GeistPixel, sans-serif;
    line-height: 1.3;
    min-width: 5.6rem;
    margin: 0;
    flex-shrink: 0;
  }

  .itemContent {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
    flex: 1;
  }

  .itemTitle {
    font-weight: 500;
    margin: 0;
  }

  .itemBody {
    margin: 0;
    max-width: 640px;
  }
</style>
