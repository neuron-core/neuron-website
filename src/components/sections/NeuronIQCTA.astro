---
import Typography from '~components/ui/Typography.astro';
import Button from '~components/ui/Button.astro';
import neuronIqLogo from '~assets/icons/neuron-iq-logo-dark.svg';
---

<div class="wrapper">
  <div class="content">
    <div class="card">
      <div class="stripe">
        <div class="bar agents" />
        <div class="bar workflows" />
        <div class="bar vector" />
        <div class="bar monitoring" />
      </div>
      <div class="cardInner">
        <div class="text">
          <Typography tag="span" styling="paragraphM" font="pixel" color="soft">
            NEURON IQ
          </Typography>
          <Typography tag="h2" styling="headingL">
            Want more?
          </Typography>
          <Typography tag="p" styling="paragraphL" color="subtle">
            Neuron IQ is the Neuron distribution that includes support,
            consultancy, training and certifications from the team that created
            it, plus the tools to take your agents to production. When something
            blocks your agents, you talk directly with the people who wrote the
            framework, and your bugs get fixed first.
          </Typography>
          <div class="ctas">
            <Button href="https://neuron-iq.dev" text="Discover Neuron IQ" />
          </div>
        </div>

        <img
          class="logo"
          src={neuronIqLogo.src}
          alt="Neuron IQ"
          width={neuronIqLogo.width}
          height={neuronIqLogo.height}
        />
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .wrapper {
    width: 100%;
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--s-64) 0;

    @include media-min('lg') {
      padding: var(--s-100) 0;
    }
  }

  .card {
    border: 1px solid var(--border-soft);
    background: var(--bg-weak);
  }

  .stripe {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 8px;
  }

  .agents {
    background: var(--bg-agents-base);
  }

  .workflows {
    background: var(--bg-workflows-base);
  }

  .vector {
    background: var(--bg-vector-base);
  }

  .monitoring {
    background: var(--bg-monitoring-base);
  }

  .cardInner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-46);
    align-items: center;

    padding: var(--s-46) var(--s-24);

    @include media-min('md') {
      padding: var(--s-64) var(--s-46);
    }

    @include media-min('lg') {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--s-64);
    }
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    align-items: flex-start;
  }

  .logo {
    width: 200px;
    height: auto;

    @include media-min('lg') {
      justify-self: center;
      width: 300px;
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-12);
  }
</style>
