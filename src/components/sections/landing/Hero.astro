---
import fs from 'node:fs';
import path from 'node:path';
import Typography from '~components/ui/Typography.astro';
import Button from '~components/ui/Button.astro';
import { Image } from 'astro:assets';
import heroGrid from '~assets/hero-grid.svg';

const iconsDir = path.resolve('src/assets/icons');

const socials = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/106896704/',
    icon: fs.readFileSync(path.join(iconsDir, 'linkedin.svg'), 'utf-8'),
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/neuronai_php_adk/',
    icon: fs.readFileSync(path.join(iconsDir, 'instagram.svg'), 'utf-8'),
  },
  {
    name: 'X',
    href: 'https://x.com/neuronai_php',
    icon: fs.readFileSync(path.join(iconsDir, 'x.svg'), 'utf-8'),
  },
];
---

<div class="heroWrapper">
  <Image src={heroGrid} alt="" class="heroGrid" />

  <div class="heroContent">
    <div class="leftSide">
      <Typography tag="h1" class="title">
        The First Agentic Framework <br />Of The PHP Ecosystem
      </Typography>

      <Typography class="subtitle" color="subtle" tag="p" styling="headingS">
        Welcome to the PHP Agentic Era. Your next application will be agentic.
        Build it in the technology you love.
      </Typography>

      <div class="buttons">
        <Button href="https://docs.neuron-ai.dev/" text="read docs" />
        <Button
          href="https://github.com/neuron-core/neuron-ai"
          variant="outline"
          text="Join github +2.2k stars"
        />
      </div>

      <div class="socials">
        <Typography tag="span" styling="paragraphM" color="subtle">
          Follow us on:
        </Typography>

        <div class="socialLinks">
          {
            socials.map((social) => (
              <a
                class="socialLink"
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global lang="scss">
  @use '~styles/mixins/media' as *;

  .heroWrapper {
    position: relative;

    overflow: hidden;

    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
  }

  .heroGrid {
    pointer-events: none;

    position: absolute;
    top: 0;
    right: 0;

    display: none;

    width: auto;
    height: 100%;

    @include media-min('xl') {
      display: block;
    }
  }

  .heroContent {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 200px 0;
  }

  .title {
    @include media-min('md') {
      overflow: hidden;
      white-space: nowrap;
    }
  }

  .subtitle {
    max-width: 600px;
    padding-top: var(--s-24);
    padding-bottom: var(--s-40);
  }

  .buttons {
    display: flex;
    gap: var(--s-12);
  }

  .socials {
    display: flex;
    gap: var(--s-16);
    align-items: center;
    margin-top: var(--s-24);
  }

  .socialLinks {
    display: flex;
    gap: var(--s-12);
  }

  .socialLink {
    display: flex;
    color: var(--text-subtle);

    &:hover {
      color: var(--text-primary);
    }

    svg {
      width: var(--s-20);
      height: var(--s-20);
    }
  }

  .leftSide {
    display: flex;
    flex-direction: column;
  }
</style>
