---
import fs from 'node:fs';
import path from 'node:path';
import Typography from '~components/ui/Typography.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const iconsDir = path.resolve('src/assets/icons');

const socials = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/106896704/',
    icon: fs.readFileSync(path.join(iconsDir, 'linkedin.svg'), 'utf-8'),
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/neuronai_php_adk/',
    icon: fs.readFileSync(path.join(iconsDir, 'instagram.svg'), 'utf-8'),
  },
  {
    name: 'X',
    href: 'https://x.com/neuronai_php',
    icon: fs.readFileSync(path.join(iconsDir, 'x.svg'), 'utf-8'),
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@neuronai_php',
    icon: fs.readFileSync(path.join(iconsDir, 'youtube.svg'), 'utf-8'),
  },
];
---

<div class:list={['socials', className]}>
  <Typography tag="span" styling="paragraphM" color="subtle">
    Follow us on:
  </Typography>

  <div class="socialLinks">
    {
      socials.map((social) => (
        <a
          class="socialLink"
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
          set:html={social.icon}
        />
      ))
    }
  </div>
</div>

<style lang="scss">
  .socials {
    display: flex;
    gap: var(--s-16);
    align-items: center;
  }

  .socialLinks {
    display: flex;
    gap: var(--s-12);
  }

  .socialLink {
    display: flex;
    color: var(--text-subtle);

    &:hover {
      color: var(--text-primary);
    }

    :global(svg) {
      width: var(--s-20);
      height: var(--s-20);
    }
  }
</style>
